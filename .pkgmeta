package-as: GuildOS

# Libraries are embedded directly as .lua files in Libs/
# No externals needed — avoids path conflicts with single-file libs

ignore:
  - README.md
  - CURSEFORGE.md
  - CHANGELOG.md
  - LICENSE
  - .github
  - .gitignore
  - .gitattributes
  - .luacheckrc
  - screenshots
  # Development harnesses. They run under plain lua5.1 outside the game and
  # stub the WoW API, so shipping them would put fake GetGuildRosterInfo and
  # friends inside the addon folder.
  - tools
  - "*.md"

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

enable-nolib-creation: no
